{
  "name": "vinkora",
  "private": true,
  "version": "1.0.0",
  "description": "Vinkora is a Next.js platform for creating, customizing, sharing, and managing short links and QR codes.",
  "license": "MIT",
  "author": "Sombre-mael",
  "keywords": [
    "url-shortener",
    "qr-code",
    "react",
    "nextjs",
    "vinkora"
  ],
  "type": "module",
  "packageManager": "pnpm@11.10.0",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "test": "tsx --test tests/security-phase1.test.ts tests/link-transition.test.ts tests/plans-catalog.test.ts",
    "test:security": "tsx --test tests/security-phase1.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/adapter-neon": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "dotenv": "^17.4.2",
    "lucide-react": "^0.562.0",
    "next": "16.2.10",
    "qrcode.react": "^4.2.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "sonner": "^2.0.7"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.1",
    "eslint-config-next": "16.2.10",
    "prisma": "^7.9.0",
    "tsx": "^4.23.1",
    "typescript": "~5.9.3"
  }
}
