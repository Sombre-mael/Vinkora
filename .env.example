DATABASE_URL="postgresql://user:password@host-pooler/database?sslmode=require"
DIRECT_URL="postgresql://user:password@host/database?sslmode=require"

# Anonymous dynamic QR beta. Keep disabled until the migration is applied.
DYNAMIC_QR_BETA_ENABLED="false"
ANONYMOUS_QR_HASH_SECRET="replace-with-at-least-32-random-characters"
ANALYTICS_HASH_SECRET="replace-with-a-different-32-character-secret"
ANONYMOUS_QR_IP_DAILY_LIMIT="50"
CRON_SECRET="replace-with-a-random-cron-secret"
